{
  "name": "noesis-app",
  "private": true,
  "version": "0.1.0",
  "description": "Noesis web app: deterministic, evidence-led cognitive training with an Android export path.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "ai:simulate": "tsx scripts/ai-drive.ts",
    "ai:verify": "tsx scripts/verify-mechanics.ts",
    "android:add": "cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:build": "node scripts/android-build.mjs",
    "android:open": "npm run android:sync && cap open android",
    "test:all": "node scripts/test-all.mjs",
    "ci": "npm run typecheck && npm run test:all && npm run ai:verify && npm run build",
    "ui:shots": "node scripts/ui-shots.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "tar": "^7.5.22",
    "glob": "^14.0.3",
    "minimatch": "^11.0.3"
  }
}
